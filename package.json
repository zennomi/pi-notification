{
  "name": "pi-notification",
  "version": "0.1.0",
  "description": "Telegram notifications, notify_user, and agent recaps for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "zennomi",
  "keywords": [
    "pi-package",
    "pi-extension",
    "pi-coding-agent",
    "telegram",
    "notifications"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/zennomi/pi-notification"
  },
  "bugs": {
    "url": "https://github.com/zennomi/pi-notification/issues"
  },
  "homepage": "https://github.com/zennomi/pi-notification#readme",
  "files": [
    "extensions/",
    "lib/",
    "skills/",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/extension-entrypoints.test.mjs tests/notify-*.test.mjs tests/pi-sdk-smoke-contract.test.mjs tests/release-trigger-contract.test.mjs",
    "ci": "npm run typecheck && npm test && npm run smoke:pi && npm pack --dry-run",
    "smoke:pi": "node scripts/pi-sdk-smoke.mjs"
  },
  "pi": {
    "extensions": [
      "./extensions/notify/index.ts"
    ],
    "skills": [
      "./skills"
    ]
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": "*",
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-tui": "*",
    "typebox": "*"
  },
  "devDependencies": {
    "@earendil-works/pi-agent-core": "1.2.0",
    "@earendil-works/pi-ai": "1.2.0",
    "@earendil-works/pi-coding-agent": "1.2.0",
    "@earendil-works/pi-tui": "1.2.0",
    "@types/node": "^26.6.4",
    "typebox": "latest",
    "typescript": "^7.0.2"
  },
  "overrides": {
    "protobufjs": ">=7.6.3 <8.0.0"
  }
}
